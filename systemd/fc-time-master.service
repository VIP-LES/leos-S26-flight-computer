[Unit]
Description=LEOS Flight Computer - Time Master (GPS + Cyphal time sync)
After=network.target

[Service]
Type=simple
User=leos-flight-computer
WorkingDirectory=/home/leos-flight-computer/leos-S26-flight-computer
ExecStart=/home/leos-flight-computer/leos-S26-flight-computer/.venv/bin/python -m fc.services.time_master
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target