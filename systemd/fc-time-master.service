[Unit]
Description=LEOS Flight Computer - Time Master (GPS + Cyphal time sync)
After=network.target

[Service]
Type=simple
User=vip
WorkingDirectory=/home/vip/leos-S26-flight-computer
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/vip/leos-S26-flight-computer/.venv/bin/python -m fc.services.time_master
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
