[Unit]
Description=LEOS Flight Computer - Time Master (GPS + Cyphal time sync)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/leos-S26-flight-computer
RuntimeDirectory=leos
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -m fc.services.time_master
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target