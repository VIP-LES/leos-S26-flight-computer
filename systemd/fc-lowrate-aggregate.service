[Unit]
Description=LEOS Flight Computer - Low-rate telemetry aggregator
After=network.target fc-time-master.service
Requires=fc-time-master.service

[Service]
Type=simple
User=leos-flight-computer
WorkingDirectory=/home/leos-flight-computer/leos-S26-flight-computer
ExecStart=/home/leos-flight-computer/leos-S26-flight-computer/.venv/bin/python -m fc.services.lowrate_aggregate
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target