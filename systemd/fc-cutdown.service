[Unit]
Description=LEOS Flight Computer - Cutdown
After=fc-time-master.service

[Service]
Type=simple
User=vip
WorkingDirectory=/home/vip/leos-S26-flight-computer
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/vip/leos-S26-flight-computer/.venv/bin/python -m fc.services.cutdown
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
