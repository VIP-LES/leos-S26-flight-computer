[Unit]
Description=LEOS Flight Computer - Logger (Cyphal -> SD)
After=network.target
# Optional: if you want it to wait for aggregate/time master
After=fc-time-master.service fc-lowrate-aggregate.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/leos-S26-flight-computer
ExecStart=/usr/bin/python3 -m fc.services.logger
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target