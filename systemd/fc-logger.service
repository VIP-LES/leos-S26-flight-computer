[Unit]
Description=LEOS Flight Computer - Logger (Cyphal -> SD)
After=fc-time-master.service fc-lowrate-aggregate.service

[Service]
Type=simple
User=leos-flight-computer
WorkingDirectory=/home/leos-flight-computer/leos-S26-flight-computer
ExecStart=/home/leos-flight-computer/leos-S26-flight-computer/.venv/bin/python -m fc.services.logger
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target